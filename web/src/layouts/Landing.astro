---
import "../styles/tokens.css";
import "../styles/landing.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const docs = `${base.replace(/\/$/, "")}/docs/`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Match Starlight's storage key so the docs and the landing page
      // agree on the theme across navigations. Light is the default: only
      // an explicit choice turns the site dark.
      const stored = localStorage.getItem("starlight-theme");
      if (stored === "dark" || stored === "light") {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>
  <body>
    <header class="site-nav">
      <div class="site-nav-inner">
        <a class="brand" href={base}>
          <span class="brand-mark">π</span>
          <span class="brand-suffix">pi-go</span>
        </a>
        <nav class="site-nav-links">
          <a href={base} aria-current="page">Home</a>
          <a href={docs}>Documentation</a>
          <a href={`${docs}capabilities/`}>Capabilities</a>
          <a href="https://pkg.go.dev/github.com/sonnes/pi-go">pkg.go.dev</a>
          <a href="https://github.com/sonnes/pi-go">GitHub</a>
        </nav>
        <div class="theme-toggle" id="theme">
          <button data-theme-set="light">Light</button>
          <button data-theme-set="dark">Dark</button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="foot">
        <span class="micro">MIT License · Ravi Atluri &amp; contributors</span>
        <div class="foot-links">
          <a class="micro" href={docs}>Docs</a>
          <a class="micro" href="https://github.com/sonnes/pi-go">GitHub</a>
          <a class="micro" href="https://pkg.go.dev/github.com/sonnes/pi-go">pkg.go.dev</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Theme toggle, install tabs, copy buttons, and the story grid.
      // No other JavaScript ships on this page.
      const root = document.documentElement;

      const syncTheme = () => {
        document.querySelectorAll("[data-theme-set]").forEach((b) => {
          b.setAttribute("aria-pressed", String(b.dataset.themeSet === root.dataset.theme));
        });
      };
      document.querySelectorAll("[data-theme-set]").forEach((b) =>
        b.addEventListener("click", () => {
          root.dataset.theme = b.dataset.themeSet;
          localStorage.setItem("starlight-theme", b.dataset.themeSet);
          syncTheme();
        }),
      );
      syncTheme();

      document.querySelectorAll("[data-tabs]").forEach((group) => {
        const name = group.dataset.tabs;
        const tabs = group.querySelectorAll("[data-tab]");
        tabs.forEach((tab) =>
          tab.addEventListener("click", () => {
            tabs.forEach((t) => t.classList.toggle("is-active", t === tab));
            document.querySelectorAll(`[data-panel="${name}"]`).forEach((p) => {
              p.hidden = p.dataset.for !== tab.dataset.tab;
            });
          }),
        );
      });

      document.querySelectorAll("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const scope = btn.closest(".codeframe, .install-row");
          const src = scope.querySelector("pre code, pre, code:not([hidden])");
          navigator.clipboard?.writeText(src.textContent.trim());
          const was = btn.textContent;
          btn.textContent = "Copied";
          setTimeout(() => (btn.textContent = was), 1200);
        });
      });

      /* The story grid: a sticky demo pane beside a scrolling narrative.
         The section nearest the middle of the viewport is active. It holds
         full ink, the rest dim, and the pane swaps to that section's demo. */
      const grid = document.querySelector("[data-story]");
      if (grid && !window.matchMedia("(max-width: 62rem)").matches) {
        const sections = [...grid.querySelectorAll("[data-section]")];
        const stage = grid.querySelector("[data-stage]");
        const demos = {};
        sections.forEach((s) => {
          const slot = s.querySelector("[data-demo]");
          if (slot) demos[s.dataset.section] = slot.innerHTML;
        });

        let current = sections[0]?.dataset.section ?? null;

        const activate = (id) => {
          if (id === current) return;
          current = id;
          sections.forEach((s) => s.classList.toggle("is-active", s.dataset.section === id));
          if (!demos[id]) return;
          stage.classList.add("is-swapping");
          setTimeout(() => {
            stage.innerHTML = demos[id];
            stage.classList.remove("is-swapping");
          }, 140);
        };

        const pick = () => {
          const mid = window.innerHeight / 2;
          let best = null;
          let bestDist = Infinity;
          for (const s of sections) {
            const r = s.getBoundingClientRect();
            const d = Math.abs(r.top + r.height / 2 - mid);
            if (d < bestDist) {
              bestDist = d;
              best = s;
            }
          }
          if (best) activate(best.dataset.section);
        };

        let ticking = false;
        addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              pick();
              ticking = false;
            });
          },
          { passive: true },
        );
        addEventListener("resize", pick);
        pick();
      }
    </script>
  </body>
</html>
