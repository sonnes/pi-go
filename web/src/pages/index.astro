---
import Landing from "../layouts/Landing.astro";
import CodeFrame from "../components/CodeFrame.astro";

const base = import.meta.env.BASE_URL;
const docs = `${base.replace(/\/$/, "")}/docs/`;

const oneCall = `
import (
    "github.com/sonnes/pi-go/pkg/ai"
    "github.com/sonnes/pi-go/pkg/pi"
)

msg, err := pi.GenerateText(ctx, "claude-sonnet-4-5", ai.Prompt{
    Messages: []ai.Message{ai.UserMessage("Write a haiku about Go.")},
})`;

const providerIface = `
// The whole provider contract.
type Provider interface {
    Generate(ctx context.Context, p Prompt) (Stream, error)
}

// A different provider is a different constructor,
// not a different program.
p := anthropic.New(anthropic.WithAPIKey(key))
p = openai.New(openai.WithAPIKey(key))
p = google.New(google.WithAPIKey(key))

a, err := pi.Agent(model, pi.WithProvider(p))`;

const contextCode = `
// The message slice belongs to you.
msgs := state.Messages()
msgs = keepLastTurns(msgs, 12)

// Cache breakpoints are marks on a message.
msgs[0].CacheControl = ai.CacheEphemeral

// Compaction is a function you write.
func compact(ctx context.Context, m []ai.Message) []ai.Message {
    sum, _ := pi.GenerateText(ctx, small, ai.Prompt{
        Messages: append(m, ai.UserMessage("Summarize.")),
    })
    return []ai.Message{ai.AssistantMessage(sum.Text())}
}`;

const streamCode = `
ctx, cancel := context.WithCancel(ctx)
defer cancel()

s := a.Run(ctx, ai.UserMessage("ship it"))

for e, err := range s.Events() {
    if err != nil {
        return err
    }

    switch e.Type {
    case agent.EventTextDelta:
        io.WriteString(w, e.Delta)
    case agent.EventToolCall:
        log.Printf("-> %s", e.Tool.Name)
    case agent.EventTurnEnd:
        cancel() // stop after this turn
    }
}`;

const toolCode = `
// Tools are generic functions. pi-go derives the
// schema from the input type, so the two cannot differ.
type WeatherIn struct {
    City string \`json:"city"\`
}

weather := ai.DefineTool(
    "get_weather",
    "Get current weather for a city",
    func(ctx context.Context, in WeatherIn) (WeatherOut, error) {
        return WeatherOut{Temp: "22°C"}, nil
    },
)

a, _ := pi.Agent(model, pi.WithTools(weather))`;

const providers = [
  ["anthropic", "key · oauth", "yes", "yes"],
  ["openai", "key · oauth", "yes", "yes"],
  ["openairesponses", "key", "yes", "yes"],
  ["google", "key", "yes", "yes"],
  ["claudecli", "subprocess", "yes", "yes"],
  ["codex", "subprocess", "yes", "yes"],
  ["geminicli", "oauth", "yes", "partial"],
];

const notBuilt = [
  [
    "No prompt DSL",
    "Prompts are Go strings and Go templates. You already know how to build a string.",
  ],
  [
    "No vector store",
    "Retrieval is a function that returns messages. You bring the store that you already run.",
  ],
  [
    "No global registry",
    "There is no init-time magic and no import side effect. You pass the provider that you want.",
  ],
  [
    "No reflection at run time",
    "pi-go derives a tool schema once, at definition, from the type. It scans nothing on each call.",
  ],
  [
    "No agent orchestrator",
    "Sub-agents are goroutines that call agents. You compose them, and the examples show how.",
  ],
  [
    "No telemetry",
    "There is no phone-home and no analytics. You can wrap the transport to get traces.",
  ],
];
---

<Landing
  title="pi-go — an agent SDK that is just Go"
  description="A minimal agent SDK for Go. Ordinary packages, explicit types, seven providers behind one interface."
>
  {/* ============ HERO ============ */}
  <header class="hero">
    <p class="hero-prompt">$ pi-go --version</p>
    <h1>There are many agent SDKs<br />this one is <em>Go you can read</em></h1>
    <p class="hero-sub">
      Ordinary packages, explicit types, no framework to learn.<br />
      Three of them — you can read the whole thing in an afternoon.
    </p>

    <div class="install">
      <div class="tabs" data-tabs="install">
        <button class="tab is-active" data-tab="get">go get</button>
        <button class="tab" data-tab="core">core only</button>
        <button class="tab" data-tab="prov">one provider</button>
        <button class="tab" data-tab="cli">cli</button>
      </div>
      <div class="install-row">
        <span class="sig">$</span>
        <code data-panel="install" data-for="get">go get github.com/sonnes/pi-go/pkg/pi</code>
        <code data-panel="install" data-for="core" hidden
          >go get github.com/sonnes/pi-go/pkg/ai</code
        >
        <code data-panel="install" data-for="prov" hidden
          >go get github.com/sonnes/pi-go/pkg/ai/provider/anthropic</code
        >
        <code data-panel="install" data-for="cli" hidden
          >go install github.com/sonnes/pi-go/cmd/pi@latest</code
        >
        <button class="copy" data-copy>Copy</button>
      </div>
    </div>

    <p class="hero-meta">MIT · Go 1.26 · one Go module for each provider</p>

    <div class="hero-actions">
      <a class="btn btn--primary" href={docs}>Read the documentation</a>
      <a class="btn" href="https://github.com/sonnes/pi-go">GitHub</a>
    </div>
  </header>

  {/* ============ STORY GRID ============ */}
  <div class="story" data-story>
    <div class="story-demo">
      <div class="story-stage" data-stage>
        <CodeFrame path="one_call.go" code={oneCall} copy={false} />
      </div>
    </div>

    <div class="story-copy">
      {/* -- 01 -- */}
      <section class="story-section is-active" data-section="why">
        <div class="kicker"><span class="num">01</span> Why pi-go</div>
        <h2>A library, not a framework</h2>
        <p>pi-go is a set of small Go packages. You call them. They do not call you.</p>
        <p>
          There is no runtime to start, no configuration file to learn, and no plugin lifecycle to
          fit your program into.
        </p>
        <p>
          Start with one function. <code>pi.GenerateText</code> takes a model name and a prompt, and
          returns a message. When you need tools, sessions, or streams, you use a lower layer. The
          types stay the same.
        </p>
        <p>
          <strong>Three layers:</strong>
          <code>pkg/ai</code> for the types, <code>pkg/agent</code> for the loop, and
          <code>pkg/pi</code> for the shortcuts. Use as many as you need.
        </p>
        <div class="section-demo" data-demo>
          <CodeFrame path="one_call.go" code={oneCall} copy={false} />
        </div>
      </section>

      {/* -- 02 -- */}
      <section class="story-section" data-section="provider">
        <div class="kicker"><span class="num">02</span> Providers</div>
        <h2>Change the provider, not your agent</h2>
        <p>
          <code>ai.Provider</code> has one method. Every provider in the repository is that interface
          and nothing more.
        </p>
        <p>
          API keys and OAuth use the same transport middleware. A subscription login and an API key
          look the same to your code.
        </p>
        <p>
          pi-go refreshes an OAuth token and stores the result. If the refresh fails, the request
          fails. It does not retry in silence.
        </p>
        <p>
          Each provider is a separate Go module. You can import Anthropic without the Google SDK.
        </p>
        <div class="section-demo" data-demo>
          <CodeFrame path="provider.go" code={providerIface} copy={false} />
        </div>
      </section>

      {/* -- 03 -- */}
      <section class="story-section" data-section="models">
        <div class="kicker"><span class="num">03</span> Coverage</div>
        <h2>Seven providers, hundreds of models</h2>
        <p>
          pi-go includes Anthropic, OpenAI, OpenAI Responses, Google, Claude CLI, Codex, and Gemini
          CLI. Some talk to an API over HTTP. Others start a command line tool as a subprocess.
        </p>
        <p>
          The <a href={`${docs}capabilities/`}>capability matrix</a> is in the repository. It records
          what each upstream API supports, and what pi-go implements, for each feature.
        </p>
        <p>
          You can add your own models with a catalog entry. You can add your own provider with one
          method.
        </p>
        <div class="section-demo" data-demo>
          <div class="codeframe">
            <div class="frame-head">
              <span class="frame-path">providers</span>
              <span class="frame-badge"><i class="dot"></i>7 modules</span>
            </div>
            <table class="matrix">
              <thead>
                <tr><th>Provider</th><th>Auth</th><th>Stream</th><th>Tools</th></tr>
              </thead>
              <tbody>
                {
                  providers.map(([id, auth, stream, tools]) => (
                    <tr>
                      <td class="mono">{id}</td>
                      <td>{auth}</td>
                      <td class="ok">{stream}</td>
                      <td>{tools}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {/* -- 04 -- */}
      <section class="story-section" data-section="sessions">
        <div class="kicker"><span class="num">04</span> Sessions</div>
        <h2>A session is an append-only log</h2>
        <p>
          A session is a list of events. pi-go writes each event once and never changes it. State is
          the result of a replay.
        </p>
        <p>
          That makes the history honest. You can find the turn where a run went wrong, instead of a
          summary of it.
        </p>
        <p>
          Because the log only grows, a branch costs nothing. Fork at any message, try the other
          approach, and keep both. The tree is the session.
        </p>
        <p>
          The file store holds one event log for each session. There is nothing to migrate, and you
          can read it with <code>grep</code>.
        </p>
        <div class="section-demo" data-demo>
          <div class="codeframe">
            <div class="frame-head">
              <span class="frame-path">session.tree</span>
              <span class="frame-badge"><i class="dot"></i>append only</span>
            </div>
            <div class="tree">
              <span class="d">session</span> user-42<br />
              ├─ <b>e1</b> user &nbsp;&nbsp;&nbsp;"My name is Ravi."<br />
              ├─ <b>e2</b> assistant "Noted."<br />
              ├─ <b>e3</b> user &nbsp;&nbsp;&nbsp;"What is my name?"<br />
              │ &nbsp;&nbsp;└─ <b>e4</b> assistant "Ravi." <i>← leaf</i><br />
              └─ <b>e3'</b> user &nbsp;&nbsp;"Actually, call me R." <i>← Branch(e2)</i><br />
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;└─ <b>e4'</b> assistant "Got it, R."
            </div>
          </div>
        </div>
      </section>

      {/* -- 05 -- */}
      <section class="story-section" data-section="context">
        <div class="kicker"><span class="num">05</span> Context</div>
        <h2>Context engineering, not context management</h2>
        <p>
          The message slice belongs to you. pi-go never changes it. pi-go never adds a hidden system
          prompt. pi-go never removes a message to save you tokens.
        </p>
        <p>
          <strong>Cache breakpoints</strong> are marks on a message. You control where a prompt cache
          starts, instead of waiting to find out.
        </p>
        <p>
          <strong>Compaction</strong> is a function that you write. You can summarize by topic, keep
          the last turns, or remove tool output and keep the tool calls.
        </p>
        <div class="section-demo" data-demo>
          <CodeFrame path="context.go" code={contextCode} copy={false} />
        </div>
      </section>

      {/* -- 06 -- */}
      <section class="story-section" data-section="stream">
        <div class="kicker"><span class="num">06</span> Streaming</div>
        <h2>Stream, steer, and stop</h2>
        <p>
          Events come back as a Go iterator. Text deltas, tool calls, tool results, usage, and turn
          boundaries all arrive as typed events on one channel.
        </p>
        <p>
          A <code>context.CancelFunc</code> stops a run. There is no separate stop API, no goroutine to
          signal, and no partial state left behind.
        </p>
        <p>
          You can send a message while the agent works. The message arrives after the current tool, or
          after the turn, depending on which one you ask for.
        </p>
        <div class="section-demo" data-demo>
          <CodeFrame path="stream.go" code={streamCode} copy={false} />
        </div>
      </section>

      {/* -- 07 -- */}
      <section class="story-section" data-section="modes">
        <div class="kicker"><span class="num">07</span> Modes</div>
        <h2>Four ways to run it</h2>
        <p>
          <strong>Library.</strong> The main one. You import the packages into your own service.
        </p>
        <p>
          <strong>CLI.</strong> The <code>pi</code> command gives you login, model selection, and an
          interactive chat over the same core.
        </p>
        <p>
          <strong>Subprocess agents.</strong> pi-go drives Claude Code, Codex, or Gemini CLI as
          providers, and keeps your own session log around them.
        </p>
        <p>
          <strong>WASM.</strong> The core packages build for <code>js/wasm</code>. The demos on this
          site run that way.
        </p>
        <div class="section-demo" data-demo>
          <div class="cast">
            <div class="cast-bar"><span>four_modes.sh</span></div>
            <pre><span class="d"># 1. library — import it</span>
<span class="t">import</span> "github.com/sonnes/pi-go/pkg/pi"

<span class="d"># 2. cli — interactive terminal chat</span>
<span class="p">$</span> pi chat

<span class="d"># 3. subprocess agents — drive another harness</span>
<span class="p">$</span> pi run --agent codex "fix the flaky test"

<span class="d"># 4. wasm — the same core in the browser</span>
<span class="p">$</span> GOOS=js GOARCH=wasm go build ./cmd/pi
<span class="p">$</span> <span class="caret"></span></pre>
          </div>
        </div>
      </section>

      {/* -- 08 -- */}
      <section class="story-section" data-section="primitives">
        <div class="kicker"><span class="num">08</span> Primitives</div>
        <h2>Primitives, not features</h2>
        <p>
          Tools are generic functions. pi-go derives the JSON schema from the input struct, so the
          schema and the handler cannot differ.
        </p>
        <p>
          Tests record real HTTP traffic and replay it. Each provider runs against captured responses
          from the real API. A change upstream shows up as a failed test.
        </p>
        <p>
          Retries, rate limits, sub-agents, and planning are functions that you compose. There is an
          example for each one.
        </p>
        <div class="section-demo" data-demo>
          <CodeFrame path="tools.go" code={toolCode} copy={false} />
        </div>
      </section>
    </div>
  </div>

  {/* ============ WHAT WE DID NOT BUILD ============ */}
  <section class="band" id="not-built">
    <div class="band-head">
      <div class="kicker"><span class="num">09</span> Scope</div>
      <h2>What we did not build</h2>
      <p>
        Each item below is a deliberate omission. Each one costs a few lines in your own code. Each
        one costs the library more complexity than it saves you.
      </p>
    </div>
    <div class="cards cards--scope">
      {
        notBuilt.map(([title, body]) => (
          <div class="card">
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ============ GET INVOLVED ============ */}
  <section class="band" id="involved">
    <div class="band-head">
      <div class="kicker"><span class="num">10</span> Community</div>
      <h2>Get involved</h2>
    </div>
    <div class="cards cards--links">
      <div class="card">
        <h3>Documentation</h3>
        <p>Concept guides for every package, and a capability matrix for every feature.</p>
        <a class="btn" href={docs}>Read the docs</a>
      </div>
      <div class="card">
        <h3>API reference</h3>
        <p>Every type and function, generated from the source on pkg.go.dev.</p>
        <a class="btn" href="https://pkg.go.dev/github.com/sonnes/pi-go">pkg.go.dev</a>
      </div>
      <div class="card">
        <h3>Issues</h3>
        <p>Bugs, provider gaps, and API friction. The capability matrix is the roadmap.</p>
        <a class="btn" href="https://github.com/sonnes/pi-go/issues">sonnes/pi-go</a>
      </div>
    </div>
  </section>
</Landing>
