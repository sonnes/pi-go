---
import Landing from "../layouts/Landing.astro";
import CodeFrame from "../components/CodeFrame.astro";
import WasmDemo from "../components/WasmDemo.astro";

const base = import.meta.env.BASE_URL;
const docs = `${base.replace(/\/$/, "")}/docs/`;

const oneCall = `
import (
    "github.com/sonnes/pi-go/pkg/ai"
    "github.com/sonnes/pi-go/pkg/pi"
)

msg, err := pi.GenerateText(ctx, "claude-sonnet-4-5", ai.Prompt{
    Messages: []ai.Message{ai.UserMessage("Write a haiku about Go.")},
})`;

const agentTool = `
type WeatherInput struct {
    City string \`json:"city"\`
}

var weatherTool = ai.DefineTool(
    "get_weather",
    "Get current weather for a city",
    func(ctx context.Context, in WeatherInput) (WeatherOutput, error) {
        return WeatherOutput{Temp: "22°C"}, nil
    },
)

a, err := pi.Agent("claude-sonnet-4-5",
    pi.WithTools(weatherTool),
    pi.WithMaxTurns(5),
)
defer a.Close()

s := a.Run(ctx, ai.UserMessage("What's the weather in Paris?"))
for e, err := range s.Events() {
    if e.Type == agent.EventMessageUpdate {
        fmt.Print(e.AssistantEvent.Delta)
    }
}`;

const durableHero = `
// Monday, process A.
da, err := pi.DurableAgent[ChatState](ctx, "claude-sonnet-4-5",
    durable.WithStore(store),
    durable.WithSessionID("user-42"),
)
da.Run(ctx, ai.UserMessage("My name is Ravi. Remember it.")).Wait()
da.Close()

// Thursday, process B. Same ID — same conversation.
da, _ = pi.DurableAgent[ChatState](ctx, "claude-sonnet-4-5",
    durable.WithStore(store),
    durable.WithSessionID("user-42"),
)
msgs, _ := da.Run(ctx, ai.UserMessage("What's my name?")).Wait()`;

const layers = [
  {
    id: "pi",
    tag: "Front door",
    name: "pkg/pi",
    use: "One import; providers auto-wired from environment",
    code: `a, err := pi.Agent("claude-sonnet-4-5",
    pi.WithTools(weatherTool),
)`,
  },
  {
    id: "catalog",
    tag: "Registry",
    name: "pkg/catalog",
    use: "Own your catalog: providers, models, agent factories",
    code: `c := catalog.New()
c.RegisterProvider(anthropic.New(anthropic.WithAPIKey(key)))
c.RegisterAgent("claude", claude.Factory())

a, err := c.Agent(ctx, "claude/sonnet")`,
  },
  {
    id: "agent",
    tag: "Agent loop",
    name: "pkg/agent",
    use: "Tools, hooks, turn management, run streams",
    code: `a := agent.New(lm,
    agent.WithTools(weatherTool),
    agent.WithMaxTurns(5),
)

s := a.Run(ctx, ai.UserMessage("..."))
msgs, err := s.Wait()`,
  },
  {
    id: "ai",
    tag: "Direct LLM",
    name: "pkg/ai",
    use: "Single calls: text, structured objects, images, speech",
    code: `type Review struct {
    Verdict string   \`json:"verdict"\`
    Issues  []string \`json:"issues"\`
}

out, err := ai.GenerateObject[Review](ctx, model, prompt)`,
  },
  {
    id: "durable",
    tag: "Durability",
    name: "pkg/durable",
    use: "Agents that survive restarts; branch, fork, compact",
    code: `store := session.NewMemoryStore[ChatState]()

da, err := pi.DurableAgent[ChatState](ctx, model,
    durable.WithStore(store),
    durable.WithSessionID("ticket-1183"),
)`,
  },
];

const toolSource = `
type SearchInput struct {
    Query string \`json:"query" jsonschema:"required"\`
    Limit int    \`json:"limit,omitempty"\`
}

var search = ai.DefineTool(
    "search_docs",
    "Search the project documentation",
    func(ctx context.Context, in SearchInput) (Hits, error) {
        return index.Search(in.Query, in.Limit)
    },
)`;

const toolSchema = `
{
  "name": "search_docs",
  "description": "Search the project documentation",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": { "type": "string" },
      "limit": { "type": "integer" }
    },
    "required": ["query"]
  }
}`;

const dockerfile = `
FROM golang:1.26 AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /triage ./cmd/triage

FROM gcr.io/distroless/static
COPY --from=build /triage /triage
ENTRYPOINT ["/triage"]`;

const providers = [
  ["Anthropic Messages", "anthropic-messages"],
  ["OpenAI Chat Completions", "openai-completions"],
  ["OpenAI Responses", "openai-responses"],
  ["Google Gemini", "google-generative"],
  ["Claude CLI", "claude-cli"],
  ["Codex CLI", "codex-cli"],
  ["Cursor CLI", "cursor-cli"],
];

const notBuilt = [
  [
    "No MCP client",
    "Implement the <code>Tool</code> interface over any transport, or wrap an existing CLI tool.",
  ],
  [
    "No permission UI",
    "Deny or rewrite a call in <code>BeforeTool</code>, inline with your own approval flow.",
  ],
  [
    "No sub-agent orchestrator",
    "Agents are values. Spawn them in goroutines and let a tool return the child's result.",
  ],
  [
    "No RAG or vector store",
    "Inject retrieved context in <code>BeforeCall</code>. Your index, your embedding choice.",
  ],
  [
    "No plan mode",
    "Write plans to files, or gate tools per phase with a hook and a mode flag.",
  ],
  [
    "No telemetry pipeline",
    "The five hooks plus run events are the seams. Emit OTel spans from them.",
  ],
];
---

<Landing
  title="pi-go — agents in Go that survive the restart"
  description="A provider-agnostic SDK for building AI agents in Go — from a single completion call to durable, session-backed agents."
>
  {/* ============ 01 HERO ============ */}
  <section class="band hero split">
    <div>
      <h1>Many ways to call a model.<br />This one <em>survives the restart</em>.</h1>
      <p class="hero-sub">
        A provider-agnostic SDK for building AI agents in Go — from a single completion call to
        durable, session-backed agents that pick up exactly where they left off.
      </p>

      <div class="install">
        <div class="tabs" data-tabs="install">
          <button class="tab is-active" data-tab="front">Front door</button>
          <button class="tab" data-tab="core">Core only</button>
          <button class="tab" data-tab="prov">One provider</button>
          <button class="tab" data-tab="cli">CLI</button>
        </div>
        <div class="install-row">
          <span class="sig">$</span>
          <code data-panel="install" data-for="front">go get github.com/sonnes/pi-go/pkg/pi</code>
          <code data-panel="install" data-for="core" hidden>go get github.com/sonnes/pi-go/pkg/ai</code
          >
          <code data-panel="install" data-for="prov" hidden
            >go get github.com/sonnes/pi-go/pkg/ai/provider/anthropic</code
          >
          <code data-panel="install" data-for="cli" hidden
            >go install github.com/sonnes/pi-go/cmd/pi@latest</code
          >
          <button class="copy" data-copy>Copy</button>
        </div>
      </div>

      <div class="hero-actions">
        <a class="btn btn--primary" href={docs}>Read the documentation</a>
        <a class="btn" href="#layers">Pick your layer</a>
      </div>
    </div>

    <div>
      <div class="tabs" data-tabs="hero" style="margin-bottom:0.75rem">
        <button class="tab is-active" data-tab="one">One call</button>
        <button class="tab" data-tab="agent">Agent + tool</button>
        <button class="tab" data-tab="durable">Durable</button>
      </div>

      <div data-panel="hero" data-for="one">
        <CodeFrame path="examples/onecall/main.go" code={oneCall}>
          <div class="frame-out">
            <span class="micro">stdout</span><br />
            <span class="stream"
              >Goroutines whisper,<br />channels carry what they know —<br />the compiler waits.</span
            ><span class="caret"></span>
          </div>
        </CodeFrame>
      </div>

      <div data-panel="hero" data-for="agent" hidden>
        <CodeFrame path="examples/agenttool/main.go" code={agentTool}>
          <div class="frame-out">
            <span class="micro">events</span><br />
            <span class="d">message_start · tool_call get_weather</span><br />
            <span class="d">tool_result 22°C</span><br />
            <span class="stream">It's 22°C in Paris right now.</span><span class="caret"></span>
          </div>
        </CodeFrame>
      </div>

      <div data-panel="hero" data-for="durable" hidden>
        <CodeFrame path="examples/durable/main.go" code={durableHero}>
          <div class="frame-out">
            <span class="micro">stdout · process b</span><br />
            <span class="stream">Your name is Ravi.</span><span class="caret"></span>
          </div>
        </CodeFrame>
      </div>
    </div>
  </section>

  {/* ============ 02 WHY ============ */}
  <section class="band" id="why">
    <div class="kicker"><span class="micro"><span class="num">02</span> / Why pi-go</span></div>
    <div class="grid grid--4">
      <div class="card">
        <span class="idx">01</span>
        <h3>One import to start</h3>
        <p>
          <code>pkg/pi</code> owns a default catalog and auto-wires providers from environment
          credentials on first use. Model specs are <code>"provider/model"</code>, or a bare model ID
          when only one provider serves it.
        </p>
      </div>
      <div class="card">
        <span class="idx">02</span>
        <h3>Tools are Go types</h3>
        <p>
          <code>DefineTool</code> and <code>GenerateObject[T]</code> derive JSON schemas from Go types
          at init time. A type that can't be schematized panics at startup — not mid-conversation.
        </p>
      </div>
      <div class="card">
        <span class="idx">03</span>
        <h3>Everything streams</h3>
        <p>
          Every call returns a stream. Range over <code>Events()</code> or block on
          <code>Wait()</code>. <code>GenerateText</code> is literally <code>StreamText(...).Wait()</code
          >.
        </p>
      </div>
      <div class="card">
        <span class="idx">04</span>
        <h3>Ships as one binary</h3>
        <p>
          <code>go build</code> puts the loop, the tools, the prompts and the provider client in a
          single file. Cross-compile it; run it on <code>scratch</code>.
        </p>
      </div>
    </div>
  </section>

  {/* ============ 03 LAYERS ============ */}
  <section class="band split" id="layers">
    <div>
      <div class="kicker">
        <span class="micro"><span class="num">03</span> / Pick your layer</span>
      </div>
      <h2 style="font-size:clamp(1.45rem,2.5vw,2rem)">
        The SDK is a stack.<br />Start at the top; drop down when you need control.
      </h2>
      <p style="margin-top:1rem">
        No framework, no lock-in at any level. Each layer is a normal Go package you can use on its
        own — and the layer below is always reachable.
      </p>
      <div class="layers" style="margin-top:1.5rem" data-tabs="layer">
        {
          layers.map((l, i) => (
            <button class={`layer${i === 0 ? " is-active" : ""}`} data-tab={l.id}>
              <span>
                <span class="layer-tag">{l.tag}</span>
                <span class="layer-name">{l.name}</span>
              </span>
              <span class="layer-use">{l.use}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div>
      {
        layers.map((l, i) => (
          <div data-panel="layer" data-for={l.id} hidden={i !== 0}>
            <CodeFrame path={l.name} code={l.code} copy={false} />
          </div>
        ))
      }
    </div>
  </section>

  {/* ============ 04 TYPED TOOLS ============ */}
  <section class="band" id="tools">
    <div class="kicker"><span class="micro"><span class="num">04</span> / Typed tools</span></div>
    <h2 style="font-size:clamp(1.45rem,2.5vw,2rem);max-width:30ch">
      Go types in. JSON Schema out. No runtime schema builders.
    </h2>
    <div class="split" style="margin-top:1.8rem;--split:1fr 1fr">
      <CodeFrame path="tools.go" code={toolSource} copy={false} />
      <CodeFrame
        path="derived at init — sent to the provider"
        code={toolSchema}
        lang="json"
        badge="generated"
        copy={false}
      />
    </div>
    <p style="margin-top:1.4rem">
      Tool errors become results the model can reason about, not Go errors that kill the run. Each
      tool declares whether it is safe to run in parallel — no single global mode.
    </p>
  </section>

  {/* ============ 05 DURABLE ============ */}
  <section class="band split" id="durable">
    <div>
      <div class="kicker">
        <span class="micro"><span class="num">05</span> / Durable sessions</span>
      </div>
      <h2 style="font-size:clamp(1.45rem,2.5vw,2rem)">The session ID is the memory boundary.</h2>
      <p style="margin-top:1rem">
        A ticket number, a user ID, a thread key — your application decides what it means. The same
        ID always resumes the same conversation, in any process.
      </p>
      <p>
        Persistence is per message: run input is stored before the run starts, and every message the
        loop produces is stored when it completes. Run events double as durability receipts — a
        <code>message_end</code> is forwarded only after its entries are in the store, so anything a
        consumer saw complete survives a crash.
      </p>
      <p>
        The transcript is an append-only tree with a leaf pointer. Nothing is ever mutated or
        deleted, and one mechanism covers a whole family of operations.
      </p>
    </div>
    <div>
      <div class="tree" data-static-tree>
        <span class="d">session</span> user-42<br />
        ├─ <b>e1</b> user &nbsp;&nbsp;&nbsp;"My name is Ravi."<br />
        ├─ <b>e2</b> assistant "Noted."<br />
        ├─ <b>e3</b> user &nbsp;&nbsp;&nbsp;"What's my name?"<br />
        │ &nbsp;&nbsp;└─ <b>e4</b> assistant "Ravi." <i>← leaf</i><br />
        └─ <b>e3'</b> user &nbsp;&nbsp;"Actually, call me R." <i>← Branch(e2)</i><br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;└─ <b>e4'</b> assistant "Got it, R."
      </div>
      <figcaption data-static-tree><b>Fig. 01</b> Entry tree after one branch</figcaption>

      <WasmDemo />

      <div class="grid grid--2" style="margin-top:1.5rem">
        <div class="card">
          <h3 style="font-size:1.02rem">Branch</h3>
          <p>Move the leaf earlier; the next turn grows a sibling. Edit, retry and rewind are all branches.</p>
        </div>
        <div class="card">
          <h3 style="font-size:1.02rem">Fork</h3>
          <p>Lift the active path into a separate session for what-if exploration.</p>
        </div>
        <div class="card">
          <h3 style="font-size:1.02rem">Compact</h3>
          <p>Append a summary that shrinks the model context. Nothing is deleted; rewind still works.</p>
        </div>
        <div class="card">
          <h3 style="font-size:1.02rem">Append</h3>
          <p>Persist app-defined entries — artifacts, UI state — that are never sent to the model.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ============ 06 ONE BINARY ============ */}
  <section class="band split" id="binary">
    <div>
      <div class="kicker"><span class="micro"><span class="num">06</span> / One binary</span></div>
      <h2 style="font-size:clamp(1.45rem,2.5vw,2rem)">Your agent is a binary, not a runtime.</h2>
      <p style="margin-top:1rem">
        <code>go build</code> and the whole agent is one file: the loop, the tools, the prompts, the
        provider client. Nothing to install on the target box — no Node, no venv, no
        <code>node_modules</code>, no interpreter to keep in step with production.
      </p>
      <p>
        Cross-compile to wherever it runs. One <code>GOOS</code>/<code>GOARCH</code> pair per target,
        from your laptop, no cross toolchain, no base image to match.
      </p>
      <div class="chips">
        <span class="is-lit">linux/amd64</span>
        <span class="is-lit">linux/arm64</span>
        <span>darwin/arm64</span>
        <span>windows/amd64</span>
        <span>freebsd/amd64</span>
        <span>+ 30 more</span>
      </div>
      <p class="note">
        The honest edge: subprocess agents shell out to <code>claude</code>, <code>codex</code> or
        <code>cursor</code>, so those need the CLI on the box. Everything that talks to a provider
        API travels inside the binary.
      </p>
    </div>

    <div>
      <div class="tabs" data-tabs="ship" style="margin-bottom:0.75rem">
        <button class="tab is-active" data-tab="build">Build</button>
        <button class="tab" data-tab="container">Container</button>
      </div>

      <div data-panel="ship" data-for="build">
        <figure>
          <div class="cast">
            <div class="cast-bar"><i></i><i></i><i></i><span>build</span></div>
            <pre><span class="p">$</span> CGO_ENABLED=0 go build -ldflags="-s -w" -o triage ./cmd/triage
<span class="p">$</span> ls -lh triage
<span class="d">-rwxr-xr-x</span>  <span class="t">9.5M</span>  triage

<span class="d"># same source, a different machine</span>
<span class="p">$</span> GOOS=linux GOARCH=arm64 go build -o triage.arm64 ./cmd/triage
<span class="p">$</span> scp triage.arm64 box:/usr/local/bin/triage
<span class="p">$</span> <span class="caret"></span></pre>
          </div>
          <figcaption><b>Fig. 02</b> go1.26.4 · one provider linked · measured</figcaption>
        </figure>
        <p class="note" style="margin-top:1.1rem">
          You pay for what you link. One provider is 9.5M; the <code>pkg/pi</code> front door is 27M
          because it wires all four API providers for auto-detection. Drop a layer and the binary
          drops with it.
        </p>
      </div>

      <div data-panel="ship" data-for="container" hidden>
        <CodeFrame path="Dockerfile" code={dockerfile} lang="dockerfile" badge="builds" />
        <p class="note" style="margin-top:1.1rem">
          <code>distroless/static</code> for the CA roots the provider TLS handshake needs — the one
          thing a static binary can't bring itself. On <code>scratch</code>, copy
          <code>ca-certificates.crt</code> in.
        </p>
      </div>
    </div>
  </section>

  {/* ============ 07 PROVIDERS ============ */}
  <section class="band" id="providers">
    <div class="kicker"><span class="micro"><span class="num">07</span> / Providers</span></div>
    <div class="split">
      <div>
        <h2 style="font-size:clamp(1.45rem,2.5vw,2rem)">One Go module per provider.</h2>
        <p style="margin-top:1rem">
          You import — and depend on — only the SDKs you use. OpenRouter is served by the Responses
          adapter through a dialect flag.
        </p>
        <p>
          Authenticate with API keys, or OAuth. Pi can reuse an existing Claude Code or Codex CLI
          subscription login, including on headless machines.
        </p>
        <a class="btn" href={`${docs}reference/capabilities/`} style="margin-top:0.5rem">Capability matrix →</a>
      </div>
      <table class="matrix">
        <thead>
          <tr><th>Provider</th><th>API identifier</th></tr>
        </thead>
        <tbody>
          {providers.map(([name, id]) => (
            <tr>
              <td>{name}</td>
              <td class="mono">{id}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* ============ 08 SUBPROCESS AGENTS ============ */}
  <section class="band split" id="cli">
    <div>
      <div class="kicker">
        <span class="micro"><span class="num">08</span> / Subprocess agents</span>
      </div>
      <h2 style="font-size:clamp(1.45rem,2.5vw,2rem)">agent.Agent is a contract, not a class.</h2>
      <p style="margin-top:1rem">
        The same spec string routes to different backends. <code>"claude/sonnet"</code> runs a Claude
        Code subprocess, <code>"codex/gpt-5-codex"</code> a Codex one, and a plain model ID runs the
        in-process loop against the provider's API — all behind one interface, so mocks are trivial.
      </p>
      <p>
        Subprocess agents work with subscription logins instead of API keys. The bundled
        <code>pi</code> CLI is a test-drive for all of it.
      </p>
    </div>
    <div>
      <figure>
        <div class="cast">
          <div class="cast-bar"><i></i><i></i><i></i><span>pi cli</span></div>
          <pre><span class="p">$</span> pi --model claude/sonnet "add a test for Branch"

<span class="d">→ agent claude/sonnet · subprocess · subscription login</span>
<span class="t">read</span>  pkg/session/entry.go
<span class="t">read</span>  pkg/session/entry_test.go
<span class="t">write</span> pkg/session/entry_test.go  <span class="d">+34</span>
<span class="t">bash</span>  make test
<span class="d">      ok  github.com/sonnes/pi-go/pkg/session  0.412s</span>

Added TestBranchMovesLeaf covering the sibling case.
<span class="p">$</span> <span class="caret"></span></pre>
        </div>
        <figcaption><b>Fig. 03</b> asciinema cast · claude subprocess agent</figcaption>
      </figure>
    </div>
  </section>

  {/* ============ 09 DIDN'T BUILD ============ */}
  <section class="band" id="not-built">
    <div class="kicker">
      <span class="micro"><span class="num">09</span> / What we didn't build</span>
    </div>
    <h2 style="font-size:clamp(1.45rem,2.5vw,2rem);max-width:34ch">
      The loop is small on purpose. Five hooks reach everything it does.
    </h2>
    <p style="margin:1rem 0 1.8rem">
      <code>BeforeCall</code>, <code>BeforeTool</code>, <code>AfterTool</code>, <code>AfterTurn</code
      >, <code>BeforeStop</code> — one signature each. Anything below isn't missing; it's yours to
      compose.
    </p>
    <div class="nb">
      {
        notBuilt.map(([title, body]) => (
          <div class="nb-item">
            <h4>{title}</h4>
            <p set:html={body} />
          </div>
        ))
      }
    </div>
  </section>

  {/* ============ 10 GET INVOLVED ============ */}
  <section class="band" id="involved">
    <div class="kicker"><span class="micro"><span class="num">10</span> / Get involved</span></div>
    <div class="grid grid--3">
      <div class="card">
        <h3>Documentation</h3>
        <p style="margin-bottom:0.9rem">Concepts, capability matrix, and guides for every layer.</p>
        <a class="btn btn--primary" href={docs}>Read the docs</a>
      </div>
      <div class="card">
        <h3>API reference</h3>
        <p style="margin-bottom:0.9rem">
          Every type and function, generated from source on pkg.go.dev.
        </p>
        <a class="btn" href="https://pkg.go.dev/github.com/sonnes/pi-go">pkg.go.dev/pi-go</a>
      </div>
      <div class="card">
        <h3>Issues</h3>
        <p style="margin-bottom:0.9rem">Bugs, provider gaps and feature discussion on GitHub.</p>
        <a class="btn" href="https://github.com/sonnes/pi-go/issues">sonnes/pi-go</a>
      </div>
    </div>
  </section>
</Landing>
